# Normalise text files to LF in the repository; Git picks the checkout
# line ending per platform.
* text=auto

# Shell scripts must keep LF even on a Windows checkout: with CRLF, running
# ./start.sh fails with "/usr/bin/env: 'bash\r': No such file or directory".
*.sh text eol=lf

# Never diff or convert these.
*.png binary
*.f32 binary
*.bin binary
